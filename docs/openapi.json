{
  "openapi": "3.1.0",
  "info": {
    "title": "Member Space Platform - Contract Document API",
    "description": "Contract file upload and presigned download (order 1899).",
    "version": "1.0.0"
  },
  "paths": {
    "/api/doc/contracts": {
      "post": {
        "tags": [
          "contracts"
        ],
        "summary": "Upload a contract file (PDF / DOCX / JPG / PNG, max 20 MB)",
        "description": "Stream the upload into the private bucket and create the contract.",
        "operationId": "upload_contract_api_doc_contracts_post",
        "parameters": [
          {
            "name": "X-Org-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "X-Org-Id"
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "anonymous",
              "title": "X-User-Id"
            }
          },
          {
            "name": "X-Roles",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Roles"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_contract_api_doc_contracts_post"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "file stored",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "403": {
            "description": "the caller has no upload permission"
          },
          "409": {
            "description": "the same file already exists in this organisation"
          },
          "413": {
            "description": "the file exceeds the maximum size"
          },
          "415": {
            "description": "the file type is not supported"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/doc/contracts/{contract_id}/file": {
      "get": {
        "tags": [
          "contracts"
        ],
        "summary": "Return a short lived presigned download URL",
        "operationId": "download_contract_api_doc_contracts__contract_id__file_get",
        "parameters": [
          {
            "name": "contract_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Contract Id"
            }
          },
          {
            "name": "X-Org-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "X-Org-Id"
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "anonymous",
              "title": "X-User-Id"
            }
          },
          {
            "name": "X-Roles",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Roles"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "presigned url",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "403": {
            "description": "the caller has no permission to view this contract"
          },
          "404": {
            "description": "the contract does not exist in this organisation"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_upload_contract_api_doc_contracts_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "the contract file itself"
          },
          "contract_type_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contract Type Hint",
            "description": "optional hint: new / renewal / supplement"
          },
          "member_company_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Member Company Id",
            "description": "optional member company id"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_contract_api_doc_contracts_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}